# Discord bot token from the Developer Portal. Required to run bot.py.
DISCORD_BOT_TOKEN=

# Optional. SQLite file for the live logger. Defaults to ./bot.db
# BOT_DB=bot.db

# Optional. Folder of markdown/text notes. Defaults to ./docs
# DOCS_DIR=docs

# Optional. Member snapshot interval in hours. Defaults to 6.
# SNAPSHOT_HOURS=6

# Optional. Comma-separated guild ids so slash commands show up immediately
# and the bot only logs those servers. Leave empty to watch every server the
# bot is invited to (global command sync, which can take up to an hour).
# GUILD_IDS=
# Single-id alias used when GUILD_IDS is unset:
# GUILD_ID=

# OpenAI-compatible model. All three are required to call a model.
# If any is missing, the bot quotes the retrieved notes instead of calling the network.
# Base URL should end in /v1 and should not include /chat/completions.
# Examples: https://api.openai.com/v1   or   http://127.0.0.1:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Channel blocklist, the answer cap, the display title, the org name, and how
# the bot talks are not in this file.
# Defaults: config/settings.toml and config/persona.md
# This server's overrides: copy config/settings.local.example.toml to
# config/settings.local.toml (gitignored), then ask again or use /reload.
# python admin.py blocklist list
